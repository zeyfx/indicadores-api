# SQLite local por padrão; em produção, PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/indicadores
DATABASE_URL=sqlite:///./indicadores.db

# Chave exigida em POST /etl/execucoes (header X-API-Key). Vazia = disparo pela API desligado.
ETL_API_KEY=

HTTP_TIMEOUT=30
HTTP_TENTATIVAS=3
